<?xml version="1.0" encoding="UTF-8"?>
<!--
  Checks every 2h whether App Store *Analytics* metrics have landed in Supabase,
  and posts a macOS notification the first time they do (then boots itself out).
  Install:
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.dallal.appstore.analyticscheck.plist
  Uninstall:
    launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.dallal.appstore.analyticscheck.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dallal.appstore.analyticscheck</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/gourav/dallal-sprint-dashboard/run_analytics_check.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Every 2 hours; also once at load. -->
    <key>StartInterval</key>
    <integer>7200</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/gourav/dallal-sprint-dashboard/logs/analyticscheck.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/gourav/dallal-sprint-dashboard/logs/analyticscheck.err</string>
</dict>
</plist>
