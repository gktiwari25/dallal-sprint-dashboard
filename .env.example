# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
#   cp .env.example .env   &&   edit .env

# ---- App Store Connect API (Users & Access -> Integrations -> App Store Connect API) ----
# Create a key with the "Admin" or "Sales and Finance" role; download the .p8 ONCE.
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_ID=XXXXXXXXXX
ASC_PRIVATE_KEY_PATH=/Users/gourav/dallal-sprint-dashboard/secrets/AuthKey_XXXXXXXXXX.p8

# Vendor Number: App Store Connect -> Payments and Financial Reports (top-left, e.g. 8XXXXXXX)
ASC_VENDOR_NUMBER=8XXXXXXX
# Apple App ID: App Store Connect -> your app -> App Information -> "Apple ID"
ASC_APP_ID=1234567890

# How many trailing days of Sales reports to (re)fetch each run. Apple lags ~1-2 days.
ASC_BACKFILL_DAYS=3

# ---- Supabase (service_role key — server side ONLY, bypasses RLS to write) ----
# Project Settings -> API -> service_role secret. NEVER put this in config.js / the browser.
SUPABASE_URL=https://dgcxiznnyvhddzsoaxsd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # the SECRET service_role key, not the anon key

# ---- Slack (optional) — Incoming Webhook for the App Store analytics-landed ping ----
# Create at api.slack.com/apps -> Incoming Webhooks. Paste the https://hooks.slack.com/... URL.
SLACK_WEBHOOK_URL=

# ---- Google Play (Android) analytics ----
# Service-account JSON with Play Console "download bulk reports" permission.
GOOGLE_APPLICATION_CREDENTIALS=/Users/gourav/dallal-sprint-dashboard/secrets/dallal-play-sa.json
PLAY_BUCKET_ID=pubsite_prod_XXXXXXXXXXXXXXXXX
PLAY_PACKAGE_NAME=com.app.dallal
PLAY_BACKFILL_MONTHS=2

# ---- Asana (near-live work-item state sync, every 15 min) ----
ASANA_PAT=2/xxxxxxxxxxxx/xxxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ASANA_PROJECT_GID=1214388950902741
